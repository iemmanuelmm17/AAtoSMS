# =============================================================================
# AAtoSMS settings
# =============================================================================
# Copy this file to ".env" in the same folder, then fill in the three values
# marked REQUIRED. The .env file holds the API token: keep it on the server only.
# It can be kept in another folder than the project: see env-path.example.txt.
#
# Format: NAME=value, one per line. Lines that start with # are comments; do not
# add a comment after a value. A blank value means "use the default".
# Changes take effect on the next call. No restart is needed.
#
# After editing, run:  php bin/check.php

# --- NetSapiens API -----------------------------------------------------------
# REQUIRED. Base address of ns-api v2, without a trailing slash.
NS_API_URL=https://nms1.nyc.birns.net/ns-api/v2

# REQUIRED. API key / bearer token that may read the auto attendant and send SMS.
NS_API_TOKEN=

# Seconds to wait for one API answer (2-25). The caller hears silence meanwhile.
NS_API_TIMEOUT=10

# Only if PHP cannot verify the HTTPS certificate (cURL error 60): full path of a
# CA bundle, e.g. C:/php/extras/ssl/cacert.pem. Blank = PHP / Windows default.
NS_API_CA_FILE=

# Domain to use when the PBX does not send AccountDomain, e.g. 1180.DynaCloud
NS_DEFAULT_DOMAIN=

# --- Access -------------------------------------------------------------------
# REQUIRED. Password that the To-Web URL must carry as ?key=... so that nobody
# else can make this server send texts. At least 24 characters; letters, digits
# and . _ ~ - only. Must differ from NS_API_TOKEN.
# Generate one:  php -r "echo bin2hex(random_bytes(24));"
WEBRESPONDER_KEY=

# Public address of the application: the folder that serves index.php
# (https://sms.example.com/aatosms) or index.php itself, as in the To-Web URL
# (https://sms.example.com/aatosms/index.php).
# Blank = the PBX is told to call back the same path on the same host, which is
# normally right. Set it if keys pressed by the caller seem to be ignored.
APP_URL=

# --- Text message -------------------------------------------------------------
# Auto attendant key whose message text is sent as the SMS (0-9 or *).
# Per auto attendant override: add SMSOption=<key> to the To-Web URL.
SMS_SCRIPT_OPTION=2

# User/extension that owns the SMS number the text is sent from.
# Blank = the auto attendant extension (AccountUser).
# Per auto attendant override: add SMSUser=<user> to the To-Web URL.
SMS_USER=

# How phone numbers are written in the API request:
#   11digit  18452632561   (default)
#   10digit  8452632561
#   e164     +18452632561
SMS_NUMBER_FORMAT=11digit

# Protection against using the line to flood somebody's phone: at most this many
# texts to one destination number per time window. 0 = no limit.
SMS_LIMIT_PER_DESTINATION=3
SMS_LIMIT_WINDOW_MINUTES=60

# --- Voice --------------------------------------------------------------------
# How a phone number is read back to the caller. For 8452632561:
#   words    eight, four, five, two, six, three, two, five, six, one
#   commas   8, 4, 5, 2, 6, 3, 2, 5, 6, 1
#   hyphens  8-4-5-2-6-3-2-5-6-1
#   spaces   8 4 5 2 6 3 2 5 6 1
# "words" always uses English digit names; pick "commas" for another language.
CALLER_ID_DIGIT_STYLE=words

# Text-to-speech voice and language for <Say>, as your PBX names them.
# Blank = the defaults of the PBX.
TTS_VOICE=
TTS_LANGUAGE=

# Seconds to wait for the first key before the prompt is repeated (1-60).
INPUT_TIMEOUT_SECONDS=6

# Seconds allowed between two keys while a phone number is typed (1-30).
INTERDIGIT_TIMEOUT_SECONDS=5

# How many times a prompt is played before the call ends without a text (1-10).
MAX_ATTEMPTS=3

# --- Logging and storage ------------------------------------------------------
# error | warning | info | debug
#   info   one line per call and per text sent, plus every problem (default)
#   debug  also every request and every XML answer - for troubleshooting only
LOG_LEVEL=info

# Daily log files older than this many days are deleted. 0 = keep forever.
LOG_RETENTION_DAYS=30

# Time zone of the log timestamps, e.g. America/New_York. Blank = PHP default.
LOG_TIMEZONE=

# Folder for logs, call state and send records. A relative path starts at the
# project folder; an absolute path (D:/data/aatosms) also works. The web server
# account needs write permission here, and the folder must not be web-accessible.
STORAGE_PATH=var

# --- Spoken prompts -----------------------------------------------------------
# Remove the leading # to change a prompt. {number} is replaced by the phone
# number, read in the style chosen above.
#PROMPT_MENU=To receive a text message at the number you are calling from, {number}, press 1. To enter a different mobile number, press 2.
#PROMPT_NO_CALLER_ID=We can send you a text message.
#PROMPT_ENTER_NUMBER=Please enter the ten digit mobile number, starting with the area code.
#PROMPT_CONFIRM=You entered {number}. To send the text message to this number, press 1. To enter a different number, press 2.
#PROMPT_INVALID_CHOICE=Sorry, that is not a valid selection.
#PROMPT_INVALID_NUMBER=Sorry, that is not a valid ten digit number.
#PROMPT_NO_INPUT=Sorry, we did not receive a response.
#PROMPT_SENT=Your text message has been sent. Thank you for calling. Goodbye.
#PROMPT_GOODBYE=We did not receive a valid response. Goodbye.
#PROMPT_LIMIT=A text message was already sent to this number recently. Please check your messages, or try again later. Goodbye.
#PROMPT_ERROR=We are sorry, we are unable to send the text message at this time. Please try again later. Goodbye.
