<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safety net for IIS - normally this file is never read.

  The web server should serve ONLY the "public" folder (README, "Web server"). If this
  whole project folder ends up inside a web site anyway, this file makes IIS answer
  "404 Not Found" for the private parts: the settings (.env), logs and call data (var),
  the source code and the Git data. IIS hides "bin" and "web.config" on its own.

  Note: IIS applies these names to every address below this folder. If the address of
  the application itself contains a part named "var", "src" or "tests", serve the
  "public" folder directly instead (then this file is not used at all).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment=".env" />
          <add segment=".env" />
          <remove segment=".env.example" />
          <add segment=".env.example" />
          <remove segment=".git" />
          <add segment=".git" />
          <remove segment=".github" />
          <add segment=".github" />
          <remove segment=".gitignore" />
          <add segment=".gitignore" />
          <remove segment=".gitattributes" />
          <add segment=".gitattributes" />
          <remove segment=".htaccess" />
          <add segment=".htaccess" />
          <remove segment="README.md" />
          <add segment="README.md" />
          <remove segment="var" />
          <add segment="var" />
          <remove segment="src" />
          <add segment="src" />
          <remove segment="tests" />
          <add segment="tests" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
